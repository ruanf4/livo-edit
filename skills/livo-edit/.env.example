# Livo Edit — chaves de API (todas opcionais; a Fase 1 não usa nenhuma)
# Copie este arquivo para `.env` nesta mesma pasta e preencha. O `.env` nunca é
# sobrescrito pelo instalador. Deixe em branco o que não for usar.

# Imagens/vídeos ilustrativos (Fase 2) — https://www.pexels.com/api/
PEXELS_API_KEY=

# Marcas, pessoas e logos específicos (Fase 2) — Google Programmable Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Trilha sonora composta por IA (Fase 3) — https://treblo.com/
TREBLO_API_KEY=
